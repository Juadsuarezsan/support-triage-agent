# --- LLM -------------------------------------------------------------------
# Anthropic API key. Leave empty to run every component in deterministic
# fallback mode (heuristic classifier/priority, template reply).
ANTHROPIC_API_KEY=
# Dated model ID (pinned for reproducible eval runs).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Per-call HTTP timeout (seconds) and total attempts (tenacity backoff).
LLM_TIMEOUT_S=15
LLM_MAX_ATTEMPTS=3
# USD per million tokens used for the cost_usd field.
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Intent classifier -------------------------------------------------------
# HF Hub ID or local path of the fine-tuned DistilBERT+LoRA classifier.
# Requires `pip install -e ".[ml]"`; otherwise the service falls back to
# zero-shot Claude (with key) or the keyword heuristic (without key).
CLASSIFIER_MODEL=Juadsuarezsan/distilbert-support-intent-lora
USE_LOCAL_CLASSIFIER=true

# --- Retrieval ---------------------------------------------------------------
# deterministic (hashed bag of tokens, no download) | hf (all-mpnet-base-v2, ml extra)
ENCODER_BACKEND=deterministic
# memory | qdrant
RETRIEVAL_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resolved_tickets

# --- Persistence (audit log) -------------------------------------------------
# memory | postgres
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql://support:support_dev@localhost:5432/support
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

# --- Routing thresholds ------------------------------------------------------
AUTO_RESOLVE_THRESHOLD=0.85
ESCALATE_THRESHOLD=0.60

# --- HTTP ---------------------------------------------------------------------
# Comma-separated allow-list; '*' is ignored on purpose.
CORS_ORIGINS=http://localhost:3000
# slowapi rate limit applied to POST /api/triage.
RATE_LIMIT=60/minute
LOG_LEVEL=INFO

# --- LangSmith (optional tracing) -------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=support-triage-agent

# --- Data download (scripts/download_data.py) --------------------------------
# Kaggle credentials for the Customer Support on Twitter dataset.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional HF token (Bitext is public; only needed behind rate limits).
HF_TOKEN=
